{
  "uid": "wiki-pulse",
  "title": "Wiki Pulse",
  "tags": ["clickhouse", "wikimedia"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 41,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Events stored",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT count() AS events FROM wiki.recent_changes"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Edits / second (last 5 min)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT sum(edits) / 300 AS edits_per_sec\nFROM wiki.edits_per_minute\nWHERE minute >= toStartOfMinute(now()) - INTERVAL 5 MINUTE\n  AND minute < toStartOfMinute(now())"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active wikis (time range)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT uniqExact(wiki) AS wikis\nFROM wiki.edits_per_minute\nWHERE $__timeFilter(minute)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Compression ratio (raw table)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 1, "custom": {} }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none", "text": {} },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT sum(data_uncompressed_bytes) / sum(data_compressed_bytes) AS ratio\nFROM system.columns\nWHERE database = 'wiki' AND table = 'recent_changes'"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Edits per second: humans vs. bots",
      "gridPos": { "x": 0, "y": 4, "w": 16, "h": 9 },
      "interval": "1m",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 15, "lineWidth": 2, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT\n    $__timeInterval(minute) AS time,\n    sumIf(edits, NOT is_bot) / $__interval_s AS humans,\n    sumIf(edits, is_bot) / $__interval_s AS bots\nFROM wiki.edits_per_minute\nWHERE $__timeFilter(minute)\nGROUP BY time\nORDER BY time"
        }
      ]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Busiest wikis",
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 9 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "color": { "mode": "continuous-BlPu" } }, "overrides": [] },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": { "values": true, "calcs": [], "fields": "/^edits$/" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT wiki, sum(edits) AS edits\nFROM wiki.edits_per_minute\nWHERE $__timeFilter(minute)\nGROUP BY wiki\nORDER BY edits DESC\nLIMIT 12"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Most-edited articles (raw events)",
      "gridPos": { "x": 0, "y": 13, "w": 14, "h": 10 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT wiki, title, count() AS edits, uniq(user) AS editors\nFROM wiki.recent_changes\nWHERE $__timeFilter(event_time)\n  AND type = 'edit' AND namespace = 0 AND NOT is_bot\nGROUP BY wiki, title\nORDER BY edits DESC\nLIMIT 20"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Distinct editors per wiki (uniqMerge over the rollup)",
      "gridPos": { "x": 14, "y": 13, "w": 10, "h": 10 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT wiki, uniqMerge(editors) AS editors, sum(bytes_added) AS net_bytes_added\nFROM wiki.edits_per_minute\nWHERE $__timeFilter(minute) AND NOT is_bot\nGROUP BY wiki\nORDER BY editors DESC\nLIMIT 20"
        }
      ]
    }
  ]
}
